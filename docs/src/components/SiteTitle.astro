---
// The wordmark and its cursor are separate: the cursor is a plain rectangle in
// the source artwork, so redrawing it as an element lets it blink the way a
// terminal cursor does. Its size and offset are expressed as fractions of the
// wordmark's height, taken from the artwork, so the two stay locked together
// at any rendered size.
import wordmark from "../assets/pivot-wordmark.png";
import wordmarkDark from "../assets/pivot-wordmark-dark.png";

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="pivotdb">
  <span class="wordmark">
    <img class="light:sl-hidden print:hidden" alt="" src={wordmarkDark.src} />
    <img class="dark:sl-hidden print:block" alt="" src={wordmark.src} />
    <span class="cursor" aria-hidden="true"></span>
  </span>
</a>

<style>
  .site-title {
    align-items: center;
    text-decoration: none;
    min-width: 0;
  }

  .wordmark {
    --logo-height: 1.375rem;
    display: flex;
    align-items: flex-end;
    /* Fractions of the wordmark height, measured off the source artwork. */
    gap: calc(var(--logo-height) * 0.248);
  }

  .wordmark img {
    height: var(--logo-height);
    width: auto;
  }

  .cursor {
    width: calc(var(--logo-height) * 0.594);
    height: calc(var(--logo-height) * 0.178);
    margin-bottom: calc(var(--logo-height) * 0.089);
    background-color: #3b4fe0;
    /* 530ms per half cycle is the caret rate Windows has defaulted to for
       decades and roughly what terminals use, so a full cycle is 1.06s. Five
       whole cycles is 5.3s, close to five seconds without cutting a blink in
       half, and it rests lit rather than disappearing. */
    animation: cursor-blink 1.06s steps(1, end) 5;
  }

  @keyframes cursor-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
