---
// The supplied logo includes transparent canvas around the artwork. It is
// clipped at render time so the visible wordmark retains the header's original
// size without modifying the source asset.
import wordmark from "../assets/pivot-wordmark.png";

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="pivotdb">
  <span class="wordmark">
    <span class="logo-crop">
      <img class="dark-logo light:sl-hidden print:hidden" alt="" src={wordmark.src} />
      <img class="dark:sl-hidden print:block" alt="" src={wordmark.src} />
      <span class="dark-accents light:sl-hidden print:hidden" aria-hidden="true">
        <span class="accent-cursor"></span>
      </span>
    </span>
  </span>
</a>

<style>
  .site-title {
    align-items: center;
    text-decoration: none;
    min-width: 0;
  }

  .wordmark {
    --logo-height: 1.375rem;
    display: block;
  }

  .logo-crop {
    position: relative;
    display: block;
    height: var(--logo-height);
    width: calc(var(--logo-height) * 3.644);
    overflow: hidden;
  }

  .logo-crop img {
    position: absolute;
    top: calc(var(--logo-height) * -0.238);
    left: calc(var(--logo-height) * -0.079);
    height: calc(var(--logo-height) * 1.366);
    width: auto;
  }

  .dark-logo {
    filter: invert(1);
  }

  .dark-accents,
  .accent-cursor {
    position: absolute;
    display: block;
  }

  .dark-accents {
    inset: 0;
  }

  .accent-cursor {
    top: calc(var(--logo-height) * 0.832);
    left: calc(var(--logo-height) * 3.089);
    width: calc(var(--logo-height) * 0.554);
    height: calc(var(--logo-height) * 0.099);
    background-color: #3b4fe0;
  }
</style>
