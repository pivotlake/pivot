{
  "name": "pivot-postgres-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "pivot_connect_events",
    "connection.url": "jdbc:postgresql://host.docker.internal:55432/pivot?sslmode=disable",
    "connection.user": "connect",
    "dialect.name": "PostgreSqlDatabaseDialect",
    "insert.mode": "insert",
    "pk.mode": "none",
    "auto.create": "true",
    "auto.evolve": "false",
    "batch.size": "2",
    "table.name.format": "pivot_connect_events",
    "quote.sql.identifiers": "never"
  }
}
